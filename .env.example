# ============================================
# CONFIGURACIÓN DE DJANGO
# ============================================

# Clave secreta de Django (REQUERIDO en producción)
# Genere una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-super-segura-aqui-cambiar-en-produccion

# Modo debug (IMPORTANTE: establecer en False en producción)
DEBUG=False

# Hosts permitidos (separados por comas, sin espacios)
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,localhost,127.0.0.1

# Orígenes CSRF confiables (incluir protocolo https://)
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com


# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================
# Para desarrollo con SQLite, deje estas variables vacías
# Para producción, configure PostgreSQL con estos valores

DB_NAME=proyectos_academicos_db
DB_USER=proyectos_user
DB_PASSWORD=password-seguro-de-base-de-datos
DB_HOST=localhost
DB_PORT=5432


# ============================================
# CONFIGURACIÓN DE SUPERUSUARIO (OPCIONAL)
# ============================================
# Estas variables son opcionales y útiles para scripts de despliegue automático

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=password-admin-seguro


# ============================================
# USUARIOS DE PRUEBA (OPCIONAL)
# ============================================
# Usuarios de prueba que se crearán automáticamente al desplegar

# Usuario Docente
DOCENTE_USERNAME=docente
DOCENTE_EMAIL=docente@example.com
DOCENTE_PASSWORD=docente123

# Usuario Estudiante
ESTUDIANTE_USERNAME=estudiante
ESTUDIANTE_EMAIL=estudiante@example.com
ESTUDIANTE_PASSWORD=estudiante123


# ============================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ============================================
# Para desarrollo, el sistema usa console backend (emails en terminal)
# Para producción, configure estas variables

# Backend de email (para producción usar: django.core.mail.backends.smtp.EmailBackend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciales de email
# Para Gmail: use una "Contraseña de aplicación" generada en su cuenta Google
# https://support.google.com/accounts/answer/185833
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-password-de-aplicacion-gmail

# Email remitente por defecto
DEFAULT_FROM_EMAIL=tu-email@gmail.com


# ============================================
# NOTAS DE CONFIGURACIÓN
# ============================================
#
# DESARROLLO:
# - No necesita configurar variables de entorno
# - El sistema usa SQLite y console email backend por defecto
# - DEBUG=True está habilitado por defecto
#
# PRODUCCIÓN:
# 1. Copie este archivo a .env: cp .env.example .env
# 2. Configure todas las variables marcadas como REQUERIDO
# 3. Genere una SECRET_KEY única y segura
# 4. Establezca DEBUG=False
# 5. Configure ALLOWED_HOSTS con sus dominios
# 6. Configure CSRF_TRUSTED_ORIGINS con sus URLs (incluir https://)
# 7. Configure PostgreSQL (recomendado) o deje vacío para SQLite
# 8. Configure EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# 9. Configure credenciales SMTP para notificaciones por email
# 10. Ejecute: python manage.py collectstatic
# 11. Configure su servidor web (Nginx/Apache) para servir archivos estáticos
#
# SEGURIDAD:
# - NUNCA incluya el archivo .env en el control de versiones
# - El archivo .env está en .gitignore por defecto
# - Use contraseñas fuertes y únicas
# - Para Gmail, use contraseñas de aplicación, no su contraseña principal
# - Mantenga SECRET_KEY confidencial
#
